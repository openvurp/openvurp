# Copy to `.env` for local development. Never commit real secrets.

# LLM
LLM_BACKEND=ollama
LLM_MODEL=qwen3-coder-next:cloud
# Reasoning models: false=direct answer (no thinking monologue), true=force, auto=model decides
LLM_THINK=false
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# Provider-specific keys, optional
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Provider CLI opzionali: riusano gli abbonamenti personali, non le API key.
# Esegui prima `codex login` (ChatGPT) e/o `claude` (Claude.ai).
CODEX_CLI=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_SANDBOX=read-only
CODEX_TIMEOUT_SECONDS=300
# Contesto inviato a Codex. Non scendere sotto ~100000: sotto quella soglia
# il system prompt (identita', metodo, tool, memoria) viene troncato e
# l'agente sembra aver dimenticato i propri file .md.
CODEX_CONTEXT_MAX_CHARS=180000
# Solo questa porzione di ogni risultato tool viene rimandata nel contesto Codex.
CODEX_TOOL_RESULT_MAX_CHARS=8000
CODEX_REQUIRE_CHATGPT_LOGIN=true
# Budget dedicato al system prompt dentro la finestra qui sopra: e'
# istruzione, non cronologia, e non va tagliato per fare posto ai turni.
CLI_SYSTEM_PROMPT_MAX_CHARS=80000
CLAUDE_CLI=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT_SECONDS=300
CLAUDE_CLI_CONTEXT_MAX_CHARS=180000
CLAUDE_CLI_REQUIRE_SUBSCRIPTION_LOGIN=true
CLI_AGENT_MAX_ITERATIONS=1

# Router Automatico economico: Luna normalmente, Terra solo sui prompt complessi.
# Non seleziona Ollama o API a consumo in automatico.
AUTO_ROUTER_FAST_MODEL=gpt-5.6-luna
AUTO_ROUTER_DEEP_MODEL=gpt-5.6-terra
AUTO_ROUTER_MAX_TIER=terra

# Channels
TELEGRAM_TOKEN=
# Chat id che riceve le notifiche (brief, «ho finito», permessi da
# approvare). Si parla con gli agenti dalla pagina web, non da qui.
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=

# ── Canali in ENTRATA (parlare con gli agenti da fuori) ───────────────────
# Vuota = nessuno. Aprire una porta sul proprio terminale non puo' essere il
# comportamento predefinito. Es: CHANNELS_IN=telegram,discord
CHANNELS_IN=
# In chat non c'e' una barra laterale: @nome per parlare a un agente,
# /agenti per la rubrica, /tutti per la stanza, /stop per fermarla.
DISCORD_ALLOWED_USERS=
SLACK_ALLOWED_USERS=
# WhatsApp usa Baileys (client NON ufficiale di WhatsApp Web): ci si collega
# inquadrando un QR dalla pagina Impostazioni. ATTENZIONE: Meta puo' bannare il
# numero collegato — usa un numero secondario, mai il tuo personale.
# Serve Node.js; al primo avvio scarica Baileys da solo.
WHATSAPP_ALLOWED_USERS=
DISCORD_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Runtime
MAX_ITERATIONS=20
# Le chat semplici non possono entrare in lunghi loop di chiamate.
CHAT_MAX_ITERATIONS=4
# Tetto input+output cumulativo di un singolo turno (0 = disattivato).
TURN_TOKEN_BUDGET=48000
MAX_TOKENS=4096
CONTEXT_MAX_TOKENS=64000
# Soft ceiling economico (include prompt, cronologia e schemi tool).
CONTEXT_TARGET_TOKENS=24000
COMPACT_THRESHOLD=0.60
SESSION_HISTORY_MAX_MESSAGES=40
SESSION_HISTORY_MAX_CHARS=60000
MEMORY_RETRIEVAL_CHARS=3000
CONTINUITY_PROMPT_CHARS=2000
TEMPERATURE=0.7
# Lower temperature used automatically when the model is calling tools.
TOOL_TEMPERATURE=0.2
# Real provider-delta streaming in the agent loop (including Codex App Server).
STREAMING_ENABLED=true
SANDBOX_MODE=restricted
SANDBOX_ALLOWED_PATHS=

# Semantic memory (SQLite FTS5 + optional embeddings via Ollama/OpenAI)
VECTOR_MEMORY_ENABLED=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# Privacy router: off | strict | auto.
# strict = private main sessions always run on a local model when the main
# backend is cloud. The guarantee is enforced by the runtime, not the prompt.
PRIVACY_MODE=off
PRIVACY_LOCAL_BACKEND=ollama
PRIVACY_LOCAL_MODEL=

# Autonomous heartbeat: max tool/LLM iterations per cycle (autonomy budget)
HEARTBEAT_MAX_ITERATIONS=8

# Brain judgment: route questions that matter (decisions, security, money,
# "what do you think") to a deeper model. off | auto.
ESCALATION_MODE=off
ESCALATION_DEEP_BACKEND=
ESCALATION_DEEP_MODEL=

# The art of forgetting: memories never recalled for N days fade into
# memory/.faded/ during the nightly cycle (recalls reinforce them).
MEMORY_FADE_ENABLED=true
MEMORY_FADE_IDLE_DAYS=45

# Runtime security
DAILY_LLM_BUDGET=250
# Egress allowlist for web_fetch/notify (empty = open; secrets are always blocked).
# Example: EGRESS_ALLOWLIST=docs.python.org, github.com
EGRESS_ALLOWLIST=
INTEGRITY_CHECK=true

# UI/services
DASHBOARD_ENABLED=false
# Sicurezza: di default la dashboard ascolta solo su localhost. Per esporla
# (LAN/Docker) metti DASHBOARD_HOST=0.0.0.0 e SEMPRE un DASHBOARD_TOKEN.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_TOKEN=
DASHBOARD_PORT=8420
GATEWAY_ENABLED=false
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8421

# Multiplayer web: profili persistenti che collaborano nella stessa stanza.
# Usa un modello locale/economico qui per mantenere basso il costo del team.
MULTIPLAYER_BACKEND=auto
MULTIPLAYER_MODEL=
MULTIPLAYER_MAX_AGENTS=6
MULTIPLAYER_MAX_ROUNDS=12
MULTIPLAYER_MAX_TOKENS=900
MULTIPLAYER_DAILY_CALL_BUDGET=120

# --- Router dei tool ---
# off    = tutti i tool sempre esposti (default: l'agente vede cio' che ha).
# wide   = pack essenziali sempre attivi + espansione per keyword.
# strict = solo `core` + keyword: risparmia token ma toglie capacita'.
TOOL_ROUTER_MODE=off

# --- Ricerca file (grep / find_files) ---
# Su mount lenti (es. /mnt/c di WSL2) una walk completa dura minuti e fa
# scadere il turno del provider. I tool si fermano entro questi limiti e
# dichiarano esplicitamente quando il risultato e' parziale.
SEARCH_TIME_BUDGET_SECONDS=20
SEARCH_MAX_FILES_SCANNED=20000
# Tetto di sicurezza su ogni tool: un handler che non torna piu' viene
# abbandonato invece di congelare il turno.
TOOL_HARD_TIMEOUT_SECONDS=120
# Quante volte la stessa chiamata puo' fallire identica prima che il runtime
# smetta di eseguirla (evita i loop su rifiuti stabili, es. budget esaurito).
TOOL_MAX_IDENTICAL_FAILURES=3

# --- Sciame: specialisti che l'agente convoca da solo ---
# Quando ha un dubbio vero puo' creare agenti specializzati, parlarci e farli
# discutere fra loro. Tu puoi scrivere a uno (@nome), a tutti (/swarm all) o
# farli discutere (/swarm discuss).
SWARM_ENABLED=true
SWARM_MAX_AGENTS=6
SWARM_MAX_ROUNDS=3
SWARM_MAX_TOKENS=1200
SWARM_BACKEND=
SWARM_MODEL=
SWARM_DAILY_CALL_BUDGET=200

# Strumenti degli agenti della rubrica. Vuoto = gli STESSI di openvurp:
# shell, file, processi, web, memoria, notifiche. Ogni chiamata passa comunque
# dalle approvazioni e dall'audit dell'agente principale, quindi valgono le
# stesse soglie (innocuo → parte, rischioso → chiede, distruttivo → bloccato).
# Elenco separato da virgole per restringerli.
SWARM_TOOLS=
# Di default un agente non puo' riscrivere openvurp stesso: niente evolve_self,
# plugin, riavvio. Metti true per togliere anche questo.
SWARM_TOOLS_ALLOW_SELF_EDIT=false
# Quanti giri di strumenti puo' fare un agente prima di dover rispondere.
SWARM_TOOL_ROUNDS=4

# --- Chiacchiere fra agenti ---
# Ogni tanto due agenti si scambiano due battute in "Tutti insieme", senza che
# nessuno l'abbia chiesto. Girano senza strumenti e con risposte corte, ma ogni
# battuta e' comunque una chiamata al modello: da qui si regola il ritmo.
SWARM_IDLE_CHAT=true
SWARM_IDLE_MIN_MINUTES=25
SWARM_IDLE_MAX_MINUTES=90
SWARM_IDLE_DAILY_MAX=6
# Gli agenti vivono in memory/chats/chats.db, lo stesso archivio della
# rubrica in dashboard: un solo elenco per CLI, tool e web.

# --- Avvio ---
# Menu di scelta all'apertura di `openvurp`. false = parte dritto in chat.
STARTUP_MENU=true

# Auto-update: la TUI controlla il repo git e applica gli aggiornamenti
# fast-forward sicuri da sola (smoke-test + rollback), poi si riavvia.
# Utile quando l'owner non c'è. Default off. Manuale: /update nella TUI.
AUTO_UPDATE=false
AUTO_UPDATE_INTERVAL=3600

# Media. Vision uses its own backend because subscription CLI backends such as
# Codex cannot receive image bytes. Ollama also works with cloud vision models.
# For image attachments you need a vision-capable model (e.g. `ollama pull
# llama3.2-vision`, or a cloud model that accepts images). For voice notes you
# need Whisper (`pip install faster-whisper`).
VISION_BACKEND=ollama
VISION_MODEL=llama3.2-vision
AUDIO_MODEL=base

# Audio/voice. Desktop default is silent; turn on only when useful.
AUDIO_ENABLED=true
AUDIO_TRANSCRIBE_ENABLED=true
VOICE_ENABLED=false
VOICE_TOOLS_ENABLED=false
MIC_ENABLED=false
