# Copy to `.env` for local development. Never commit real secrets.

# LLM
LLM_BACKEND=ollama
LLM_MODEL=qwen3-coder-next:cloud
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# Provider-specific keys, optional
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Channels
TELEGRAM_TOKEN=
# Comma-separated numeric Telegram user IDs. Leave empty only for local testing.
TELEGRAM_ALLOWED_USERS=
# Comportamento nei gruppi: mention (solo se taggato) | natural (decide da solo) | all
TELEGRAM_GROUP_MODE=mention
TELEGRAM_GROUP_COOLDOWN=90
# In 'natural', un modello PICCOLO/LOCALE fa il guardiano del gruppo (decide se
# intervenire) e passa la palla al modello grande. Scegli tu quale (vuoto = usa
# il principale). Es: TELEGRAM_GROUP_DECIDER_MODEL=llama3.2:3b
TELEGRAM_GROUP_DECIDER_MODEL=
TELEGRAM_GROUP_DECIDER_BACKEND=ollama
# Whitelist gruppi (chat_id separati da virgola). Se valorizzata, l'agente
# partecipa SOLO a questi gruppi e ignora tutti gli altri. Vuota = nessun limite.
# I chat_id dei gruppi sono negativi; quando arriva un gruppo fuori lista il CLI
# stampa il suo chat_id così puoi aggiungerlo. Es: TELEGRAM_GROUP_WHITELIST=-1001234567890
TELEGRAM_GROUP_WHITELIST=
DISCORD_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Runtime
MAX_ITERATIONS=50
MAX_TOKENS=16384
CONTEXT_MAX_TOKENS=128000
TEMPERATURE=0.7
# Lower temperature used automatically when the model is calling tools.
TOOL_TEMPERATURE=0.2
# Real token-by-token streaming in the agent loop.
STREAMING_ENABLED=true
SANDBOX_MODE=restricted
SANDBOX_ALLOWED_PATHS=

# Semantic memory (SQLite FTS5 + optional embeddings via Ollama/OpenAI)
VECTOR_MEMORY_ENABLED=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# Privacy router: off | strict | auto.
# strict = private main sessions always run on a local model when the main
# backend is cloud. The guarantee is enforced by the runtime, not the prompt.
PRIVACY_MODE=off
PRIVACY_LOCAL_BACKEND=ollama
PRIVACY_LOCAL_MODEL=

# Autonomous heartbeat: max tool/LLM iterations per cycle (autonomy budget)
HEARTBEAT_MAX_ITERATIONS=8

# Brain judgment: route questions that matter (decisions, security, money,
# "what do you think") to a deeper model. off | auto.
ESCALATION_MODE=off
ESCALATION_DEEP_BACKEND=
ESCALATION_DEEP_MODEL=

# The art of forgetting: memories never recalled for N days fade into
# memory/.faded/ during the nightly cycle (recalls reinforce them).
MEMORY_FADE_ENABLED=true
MEMORY_FADE_IDLE_DAYS=45

# Runtime security
DAILY_LLM_BUDGET=0
# Egress allowlist for web_fetch/notify (empty = open; secrets are always blocked).
# Example: EGRESS_ALLOWLIST=docs.python.org, github.com
EGRESS_ALLOWLIST=
INTEGRITY_CHECK=true

# UI/services
DASHBOARD_ENABLED=false
# Sicurezza: di default la dashboard ascolta solo su localhost. Per esporla
# (LAN/Docker) metti DASHBOARD_HOST=0.0.0.0 e SEMPRE un DASHBOARD_TOKEN.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_TOKEN=
DASHBOARD_PORT=8420
GATEWAY_ENABLED=false
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8421

# Auto-update: la TUI controlla il repo git e applica gli aggiornamenti
# fast-forward sicuri da sola (smoke-test + rollback), poi si riavvia.
# Utile quando l'owner non c'è. Default off. Manuale: /update nella TUI.
AUTO_UPDATE=false
AUTO_UPDATE_INTERVAL=3600

# Media. For Telegram photos you need a vision-capable model (Ollama: `ollama
# pull llama3.2-vision`, or a cloud model that accepts images). For voice notes
# you need Whisper (`pip install faster-whisper`).
VISION_MODEL=llama3.2-vision
AUDIO_MODEL=base

# Audio/voice. Desktop default is silent; turn on only when useful.
AUDIO_ENABLED=true
AUDIO_TRANSCRIBE_ENABLED=true
VOICE_ENABLED=false
VOICE_TOOLS_ENABLED=false
VOICE_BOOTSTRAP_ENABLED=false
MIC_ENABLED=false
TELEGRAM_VOICE_REPLY_ENABLED=false
